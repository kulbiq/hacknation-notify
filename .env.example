# =======================================================
# Konfiguracja HackNation Zadania Discord Bot
# =======================================================

# URL Webhooka z Discorda (Wymagane do wysyłania powiadomień)
# Uzyskasz go w Discordzie: Ustawienia kanału -> Integracje -> Webhooki -> Nowy webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Częstotliwość sprawdzania strony ze zleceniami (np. 5m, 15m, 30m, 1h)
# Domyślnie: 15m
CHECK_INTERVAL=15m

# Czy wysyłać powiadomienia o wszystkich istniejących zadaniach przy pierwszym starcie
# false = zapisuje stan początkowy do bazy i wysyła jedynie komunikat o gotowości (zalecane)
# true  = wysyła powiadomienia o każdym znalezionym zadaniu na start
NOTIFY_ON_INITIAL_RUN=false

# Czy wysyłać powiadomienie powitalne po pierwszym pomyślnym połączeniu i pobraniu zadań
SEND_STARTUP_MESSAGE=true

# Codzienne podsumowanie (Daily Summary)
# Wysyła raz dziennie raport ze stanem bazy wyzwań oraz informacją o braku zmian lub aktywności w ciągu 24h
DAILY_SUMMARY_ENABLED=true

# Godzina wysyłania codziennego podsumowania (format HH:MM np. 10:00, 18:30 lub sama godzina 0-23)
DAILY_SUMMARY_TIME=10:00

# Czy wysyłać podsumowanie TYLKO wtedy, gdy w ciągu ostatnich 24h NIC NIE DODANO ani nie zmieniono?
# false = wysyła codziennie o określonej godzinie (z podsumowaniem stanu i ew. zmian)
# true  = wysyła podsumowanie wyłącznie w dni, w których nie było żadnych zmian (status "nic nie dodano")
DAILY_SUMMARY_ONLY_IF_NO_CHANGES=false

# Strefa czasowa dla kontenera (zalecana Europe/Warsaw)
TZ=Europe/Warsaw

# Ścieżka do pliku bazy SQLite
# W kontenerze Docker domyślnie montowane pod /data/hacknation.db
DB_PATH=/data/hacknation.db
